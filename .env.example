# Copy to .env (git-ignored) and change the password:  cp .env.example .env
# Postgres reads these only when its data volume is first created; after changing them run
#   docker compose down -v   (this deletes the local data)

POSTGRES_DB=loantrack
POSTGRES_USER=loantrack
POSTGRES_PASSWORD=change-me-local-only

# Host port for the web UI
FRONTEND_PORT=8080

# Image tag and the version shown in the UI footer
APP_VERSION=v1
