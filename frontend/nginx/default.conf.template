# Rendered at container start by the nginx image's envsubst step: only ${BACKEND_URL} is
# replaced (nginx's own $variables are left alone because they are not set in the environment).

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'" always;

    # Liveness/readiness for the frontend itself - does not depend on the backend.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Resolve the backend name per request (cached 10s) instead of once at startup.
    # With a literal hostname in proxy_pass, nginx exits with "host not found in upstream"
    # if DNS is not ready when it starts - which happened after a minikube restart and put
    # the frontend into CrashLoopBackOff. NGINX_LOCAL_RESOLVERS is filled in by the image's
    # entrypoint from /etc/resolv.conf (kube-dns in Kubernetes, 127.0.0.11 in Compose).
    # nginx's resolver ignores resolv.conf search domains, so in Kubernetes BACKEND_URL
    # must be the fully-qualified Service name.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # The browser only ever calls /api/...; nginx forwards to the backend Service.
    location /api/ {
        set $backend_upstream ${BACKEND_URL};
        rewrite ^/api/(.*)$ /$1 break;      # /api/loans?x=1 -> /loans?x=1
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }

    # index.html must never be cached, so a rollout is picked up on the next refresh;
    # app.js/styles.css carry a content hash in their URL and can be cached for a long time.
    location = /index.html {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'" always;
    }
    location ~* \.(js|css)$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
